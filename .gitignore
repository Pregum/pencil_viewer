node_modules
dist
dist-ssr

# pen-audit の配布バンドルだけは例外。JavaScript アクションはリポジトリに
# 置かれたファイルをそのまま実行するので、ビルド済みを入れておく必要がある。
!tools/pen-audit/dist/
*.local
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env / secrets
.env
.env.*
!.env.example

# Claude Code session data
.claude/
.codex/

# シェルで "~/..." がクォートされて展開されないと、リテラルな ~ という
# 名前のディレクトリが作られる。誤コミットを防ぐために無視する。
/~/

# Cloudflare Workers — 実 ID 入りの wrangler.toml はコミットしない
# (テンプレートとして wrangler.toml.example をコミットする)
workers/*/wrangler.toml
.wrangler/

# Vitest coverage
coverage

# 紹介動画のレンダリング結果。素材(promo/public)とソース(promo/src)だけコミットする。
promo/out

